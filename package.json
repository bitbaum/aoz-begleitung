    "@bitbaum/chatkit": "^0.21.2",
    "@bitbaum/design-tokens": "^1.2.0",
    "@bitbaum/listkit": "^0.2.2",
    "@bitbaum/mail-kit": "^0.2.0",
    "@bitbaum/searchkit": "^0.2.3",
    "@bitbaum/sitekit": "^0.4.2",
    "@bitbaum/whenkit": "^0.3.3",
    "@fleet/ai-forms": "npm:ai-forms@^0.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sentry/nextjs": "^10.77.1",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "bip-kit": "^0.6.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "limitkit": "^0.2.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
