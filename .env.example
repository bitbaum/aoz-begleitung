# =============================================================================
# DATABASE
#
# Production is PostgreSQL 17 on the Hetzner box bitbaum (167.233.22.31),
# database aoz_wohnen, bound to localhost there. Env SSOT is
# /opt/aoz-wohnen/shared/.env on the box. See docs/INFRASTRUCTURE.md.
#
# Neon / Vercel / hosted poolers were decommissioned 2026-06-12. A laptop
# .env that still names a cloud pooler host is stale — do not restore those
# URLs, and do not treat Prisma "loaded env from .env" as production.
# =============================================================================

DATABASE_URL="postgresql://aoz_wohnen:pass@localhost:5432/aoz_wohnen"

# Direct connection URL (for Prisma migrations). On self-hosted Postgres this

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Session secret for JWT signing (generate with: openssl rand -base64 32)
# REQUIRED for production
SESSION_SECRET="your-secret-key-here"

# Session duration in seconds (default: 28800 = 8 hours)
SESSION_DURATION="28800"

# Max login attempts per 15-minute window (default: 10)
LOGIN_RATE_LIMIT="10"

# Secret for /api/cron/* routes (generate with: openssl rand -hex 32)
# REQUIRED in production — set as Authorization: Bearer <value> header
CRON_SECRET=""

# Initial admin account (used by scripts/db/seed-admin.ts)
# Change these before first deploy!
ADMIN_CODE="AOZ-ADMIN1"
ADMIN_NAME="Admin"
ADMIN_EMAIL=""

# =============================================================================
# EMAIL (Resend via @bitbaum/mail-kit)
# =============================================================================

# Resend API key (leave empty to disable email — codes shown in UI instead)
RESEND_API_KEY=""

# Sender — `Name <addr>` or bare address; the address's domain must be
# verified in Resend. Defaults to the fleet-conventional sender when unset.
RESEND_FROM="AOZ Begleitung <aoz-begleitung@fleetcrown.orangecat.ch>"

# Staff email addresses for system notifications (comma-separated)
# These receive daily summaries, incident alerts, transfer requests
STAFF_EMAIL_RECIPIENTS="staff@yourdomain.ch"

# =============================================================================
# AI ASSISTANT
#
# Set ONE of the fleet keys below. Every AI surface (form assist + staff chat)
# uses the same chain: Groq first, then OpenRouter. Anthropic is not used.
# =============================================================================

# Groq — free, fleet default. https://console.groq.com/keys
GROQ_API_KEY=""

# OpenRouter — fallback when Groq is unavailable. https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# The model ids are NOT set here on purpose. `ai-kit` carries the list and
# re-probes it against the live catalogues; setting one of these pins this app
# to a single id that will eventually be retired, and the app will not fall back
# past it. Set one only to force a specific model, and own the consequence.
# GROQ_MODEL=""
# OPENROUTER_MODEL=""

# =============================================================================
# ERROR MONITORING (Sentry - optional)
# =============================================================================

# Runtime DSN (must start with NEXT_PUBLIC_ to be visible in browser bundle)
NEXT_PUBLIC_SENTRY_DSN=""

# Build-time source-map upload credentials. Only needed if you want Sentry
# stack traces to map back to TS source. All three required together.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# =============================================================================
# QUICK ACCESS (one-click sign-in on /login, no account needed)
# =============================================================================

# The site holds only real data. Quick access signs in as NAMED REAL staff
# accounts, so the team can start without registering; each person can later
# claim their account at /register with their code. Button visibility is
# SERVER-driven (GET /api/auth/demo): a code that does not resolve to an
# ACTIVE user offers no button.
#
# Master switch. QUICK_ACCESS_ENABLED="true" works too; the older name is
# still read because the live box sets it.
DEMO_ACCESS_ENABLED="false"

# Real staff codes, comma-separated, in button order.
# Each button reads "<first name> <last initial>. · <role>".
QUICK_ACCESS_STAFF_CODES=""

# Optional client button: an UNCLAIMED placeholder resident's code
# (Resident.isPlaceholder). The button disappears once the profile is claimed.
DEMO_RESIDENT_CODE=""

# =============================================================================
# APPLICATION
# =============================================================================

# Public-facing URL (used in invite email links)
NEXT_PUBLIC_APP_URL="https://your-app.example.com"

NODE_ENV="development"
